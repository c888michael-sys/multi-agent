# Copy to .env and fill in your real keys. Never commit .env.

# --- Gemini (Stages 1-4: orchestrator + perception) ---
# Each GEMINI_KEY_N is one provider slot in the Gemini pool. Scale by adding
# GEMINI_KEY_4, _5, etc. — no code change needed. Each slot should be backed
# by its own quota bucket (separate Google Cloud project, OR separate Google
# account; multiple keys from the SAME project share one quota).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# --- Stage 6: other providers (each role used independently) ---
# Get keys from each provider's console — all free, no payment required.
# See README "Multi-provider" section for sign-up URLs and free-tier limits.
# Missing keys mean the corresponding role falls back to Gemini (or fails
# gracefully if Gemini can't fill that role either).

# DeepSeek R1 (full 671B) for the reasoning role
OPENROUTER_KEY=

# Llama 3.3 70B for action-structural (general execution)
GROQ_KEY=

# Codestral for action-code (code-specialized execution)
MISTRAL_KEY=

# Llama 4 Scout for action-repetitive (bulk, very fast)
CEREBRAS_KEY=
