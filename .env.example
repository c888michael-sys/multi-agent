# Copy to .env and fill in your real keys. Never commit .env.

# --- Google AI Studio: Gemini Flash + Gemma 4 (auto-registered together) ---
# Each GEMINI_KEY_N gets registered TWICE — once as `gemini:N` (Gemini
# 3.5 Flash, the premium small-quota slot) and once as `gemma:N` (Gemma
# 4 31B-it, the huge-quota safety net). They share a Google Cloud project
# but draw from independent per-model RPD pools on the free tier.
# Scale by adding GEMINI_KEY_4, _5, etc. — no code change needed. Each
# slot should be its own project (rate limits are per-project, not per-key).
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# --- Other providers (each role used independently) ---
# Get keys from each provider's console — all free, no payment required.
# See README "Multi-provider" section for sign-up URLs and free-tier limits.
# Missing keys mean the corresponding role falls back through its chain
# (typically ending at the Gemma safety net).

# Qwen3-Next 80B for the reasoning role's primary OpenRouter slot (`:free` route)
OPENROUTER_KEY=

# Llama 3.3 70B for action-structural (general execution)
GROQ_KEY=

# Codestral for action-code (code-specialized execution)
MISTRAL_KEY=

# GPT-OSS 120B for action-repetitive (bulk, very fast — 1M tok/day)
CEREBRAS_KEY=

# --- Optional: live web search for the `web_search` tool ---
# When the perception role falls over from gemini:3 (which has native
# Google Search grounding) to a Gemma slot, this tool gives the model a
# way to still fetch fresh web data. Free tier: ~2000 queries/month at
# brave.com/search/api. If unset, web_search falls back to DuckDuckGo
# Instant Answer (keyless, no signup, but lower coverage — only ~30% of
# arbitrary queries return a useful answer).
BRAVE_SEARCH_KEY=

# --- Optional: local Ollama tuning for hybrid mode ---
# Defaults are the safer local setup: qwen3.5:9b for reasoning and
# qwen2.5-coder:14b for coding, each with 32768 context. Override if you
# intentionally want a larger/slower local model.
# OLLAMA_REASONING_MODEL=qwen3.5:9b
# OLLAMA_CODER_MODEL=qwen2.5-coder:14b

# Global context override for both local roles. Prefer role-specific values
# below when mixing model sizes, e.g. 32B reasoner + 14B coder.
# OLLAMA_NUM_CTX=32768

# Role-specific context overrides.
# OLLAMA_REASONING_NUM_CTX=32768
# OLLAMA_CODER_NUM_CTX=32768

# Local 32B models can be slow to cold-load. Default reasoning timeout is
# 15 minutes; set this higher/lower in milliseconds if needed.
# OLLAMA_REQUEST_TIMEOUT_MS=900000
